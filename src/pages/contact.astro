---
import Base from "../layouts/Base.astro";
import { site } from "../config/site";
import { breadcrumbs } from "../lib/schema";

export const prerender = true;

const { street, city, region, postal } = site.address;
const crumbs = breadcrumbs([
  { name: "Home", path: "/" },
  { name: "Contact", path: "/contact/" },
]);
---

<Base
  title="Contact Gillette Ventures LLC by email"
  description={`Contact ${site.legalName} about partnerships, vendor and banking verification, or a venture we run. Email ${site.email} and we reply directly.`}
  schema={[crumbs]}
>
  <h1 class="rise text-4xl font-semibold tracking-[-0.035em] sm:text-5xl">Contact</h1>
  <p class="rise mt-4 max-w-prose text-lg leading-relaxed text-ink-muted" style="--i:1">
    For partnerships, vendor or banking verification, or questions about a venture under the company. We reply by email.
  </p>

  <div class="rise mt-12 grid overflow-hidden rounded-xl border border-line bg-surface-muted/60 sm:grid-cols-2" style="--i:2">
    <div class="spotlight border-b border-line p-6 sm:border-r sm:border-b-0 sm:p-10">
      <h2 class="text-sm text-ink-faint">Email</h2>
      <p class="mt-3 text-xl font-medium tracking-[-0.01em] break-words sm:text-2xl">{site.email}</p>
      <a
        href={`mailto:${site.email}`}
        class="mt-8 inline-flex h-11 items-center gap-2 rounded-lg bg-ink px-5 text-sm font-medium text-surface transition-[background-color,transform] duration-200 hover:bg-white active:scale-[0.98]"
      >
        Email us
        <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3.5 8h9m-3.5-3.5L12.5 8 9 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
    {
      street && (
        <div class="p-6 sm:p-10">
          <h2 class="text-sm text-ink-faint">Principal address</h2>
          <address class="mt-3 text-lg leading-relaxed not-italic tabular-nums">
            {site.legalName}
            <br />
            {street}
            <br />
            {city}, {region} {postal}
          </address>
        </div>
      )
    }
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLElement>(".spotlight").forEach((el) => {
    el.addEventListener("pointermove", (e) => {
      const r = el.getBoundingClientRect();
      el.style.setProperty("--x", `${e.clientX - r.left}px`);
      el.style.setProperty("--y", `${e.clientY - r.top}px`);
    });
  });
</script>
