---
import Base from "../layouts/Base.astro";
import { site } from "../config/site";
---

<Base title={site.name} description={site.description}>
  <h1 class="font-display text-4xl font-semibold tracking-tight sm:text-5xl">
    {site.name}
  </h1>
  <p class="mt-4 max-w-prose text-lg text-ink-muted">{site.description}</p>

  <div class="mt-8">
    <a
      href="/contact"
      class="inline-flex items-center rounded-md bg-brand-500 px-5 py-3 text-white transition-colors hover:bg-brand-700"
    >
      Get in touch
    </a>
  </div>
</Base>
