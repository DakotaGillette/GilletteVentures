---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="That page does not exist." noindex>
  <h1 class="font-display text-3xl font-semibold">Page not found</h1>
  <p class="mt-4 max-w-prose text-ink-muted">
    That page does not exist. It may have moved, or the link may be wrong.
  </p>
  <p class="mt-6">
    <a href="/" class="text-brand-500 underline underline-offset-4">Back to the home page</a>
  </p>
</Base>
