---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="That page does not exist." noindex>
  <h1 class="text-4xl font-semibold tracking-[-0.035em] sm:text-5xl">Page not found</h1>
  <p class="mt-4 max-w-prose text-ink-muted">
    That page does not exist. It may have moved, or the link may be wrong.
  </p>
  <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
    <li><a href="/" class="underline decoration-line-strong underline-offset-4 transition-colors hover:decoration-ink-muted">Home page</a></li>
    <li><a href="/#details" class="underline decoration-line-strong underline-offset-4 transition-colors hover:decoration-ink-muted">Company details</a></li>
    <li><a href="/contact/" class="underline decoration-line-strong underline-offset-4 transition-colors hover:decoration-ink-muted">Contact</a></li>
  </ul>
</Base>
