---
import Base from "../layouts/Base.astro";
import { site } from "../config/site";
import { breadcrumbs } from "../lib/schema";

export const prerender = true;

const effective = "October 18, 2026";
const crumbs = breadcrumbs([
  { name: "Home", path: "/" },
  { name: "Privacy policy", path: "/privacy/" },
]);
---

<Base
  title={`Privacy policy for ${site.legalName}`}
  description={`How ${site.legalName} handles information from this website: what analytics collect, how we treat email you send, and how to ask for deletion.`}
  schema={[crumbs]}
>
  <article class="legal max-w-prose">
    <h1 class="text-4xl font-semibold tracking-[-0.035em] sm:text-5xl">Privacy policy</h1>
    <p class="!mt-4 text-sm text-ink-faint">Effective {effective}</p>

    <p>
      This policy covers {site.url.replace("https://", "")}, run by {site.legalName}. Each venture under the company
      has its own site and its own privacy policy.
    </p>

    <h2>What we collect</h2>
    <ul>
      <li>
        <strong>Email.</strong> If you write to us, we receive your address and message and use them only to reply.
      </li>
      <li>
        <strong>Analytics.</strong> Google Analytics sets cookies and records the pages you view, how you arrived, your
        device and browser, and an approximate location derived from your IP address.
      </li>
      <li>
        <strong>Security and hosting logs.</strong> Cloudflare hosts the site and processes request data such as IP
        address to deliver pages and block abuse.
      </li>
    </ul>

    <h2>Who processes it</h2>
    <p>
      We do not sell or rent personal information. We share it only with the providers that run the site: Cloudflare
      (hosting and security) and Google (analytics).
    </p>

    <h2>How long we keep it</h2>
    <p>
      We keep emails as long as we need them to respond and to maintain business records. Google Analytics
      data is kept under the retention setting on our account.
    </p>

    <h2>Your choices</h2>
    <p>
      You can block or delete cookies in your browser, or install the <a
        href="https://tools.google.com/dlpage/gaoptout">Google Analytics opt-out add-on</a>. To see, correct or delete
      information you sent us, email <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>

    <h2>Children</h2>
    <p>This site is not directed to children under 13, and we do not knowingly collect their information.</p>

    <h2>Changes</h2>
    <p>If we change this policy we will update the effective date at the top of this page.</p>

    <h2>Contact</h2>
    <p>
      {site.legalName}, <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </article>
</Base>
